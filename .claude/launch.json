{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "web"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "web-pglite",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DATABASE_URL=",
        "npm",
        "run",
        "dev",
        "-w",
        "web"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "web-3005",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "web",
        "--",
        "-p",
        "3005"
      ],
      "port": 3005
    },
    {
      "name": "storybook",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "storybook"
      ],
      "port": 6006
    },
    {
      "name": "storybook-6007",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "exec",
        "-w",
        "@workspace/storybook",
        "--",
        "storybook",
        "dev",
        "-p",
        "6007",
        "--no-open"
      ],
      "port": 6007
    },
    {
      "name": "stageshow",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd spikes/stageshow && npx vite playground --config playground/vite.config.ts --port 5177 --strictPort"
      ],
      "port": 5177
    },
    {
      "name": "mobile",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "-w",
        "mobile"
      ],
      "port": 8081
    }
  ]
}
