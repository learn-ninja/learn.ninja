{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "web"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "web-pglite",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DATABASE_URL=",
        "npm",
        "run",
        "dev",
        "-w",
        "web"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "storybook",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "storybook"
      ],
      "port": 6006
    },
    {
      "name": "storybook-6007",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "exec",
        "-w",
        "@workspace/storybook",
        "--",
        "storybook",
        "dev",
        "-p",
        "6007",
        "--no-open"
      ],
      "port": 6007
    }
  ]
}
