{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "spec": {
      "type": "string",
      "const": "0.7"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35
    },
    "targetLanguage": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35
    },
    "level": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "estimatedMinutes": {
      "type": "integer",
      "minimum": 3,
      "maximum": 15
    },
    "subject": {
      "type": "string",
      "enum": [
        "programming",
        "ai",
        "tools",
        "design",
        "business",
        "marketing",
        "money",
        "science",
        "math",
        "data",
        "health",
        "history",
        "society",
        "languages",
        "arts",
        "life",
        "careers"
      ]
    },
    "tags": {
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 30,
        "pattern": "^[\\p{Ll}\\p{Lo}\\p{Lm}\\p{M}\\p{N}]+(?:-[\\p{Ll}\\p{Lo}\\p{Lm}\\p{M}\\p{N}]+)*$"
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    },
    "hook": {
      "$ref": "#/$defs/HookBrick"
    },
    "bricks": {
      "minItems": 3,
      "maxItems": 20,
      "type": "array",
      "items": {
        "$ref": "#/$defs/Brick"
      }
    },
    "challenge": {
      "$ref": "#/$defs/QuestionBrick"
    },
    "wrapup": {
      "type": "object",
      "properties": {
        "takeaways": {
          "minItems": 2,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "next": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "takeaways"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "spec",
    "title",
    "summary",
    "objective",
    "language",
    "level",
    "estimatedMinutes",
    "subject",
    "hook",
    "bricks",
    "challenge",
    "wrapup"
  ],
  "additionalProperties": false,
  "$defs": {
    "HookBrick": {
      "oneOf": [
        {
          "$ref": "#/$defs/ChoiceBrick"
        },
        {
          "$ref": "#/$defs/CompareBrick"
        }
      ]
    },
    "ChoiceBrick": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "visual": {
          "$ref": "#/$defs/Visual"
        },
        "hint": {
          "type": "string",
          "minLength": 1
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "choice"
        },
        "options": {
          "minItems": 2,
          "maxItems": 5,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Option"
          }
        },
        "correct": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "multiple": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "prompt",
        "explanation",
        "type",
        "options",
        "correct",
        "multiple"
      ],
      "additionalProperties": false
    },
    "Visual": {
      "oneOf": [
        {
          "$ref": "#/$defs/HtmlVisual"
        },
        {
          "$ref": "#/$defs/CodeVisual"
        },
        {
          "$ref": "#/$defs/MathVisual"
        },
        {
          "$ref": "#/$defs/ChartVisual"
        },
        {
          "$ref": "#/$defs/DiagramVisual"
        }
      ]
    },
    "HtmlVisual": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "html"
        },
        "html": {
          "type": "string",
          "minLength": 1
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "css": {
          "type": "string"
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "html"
      ],
      "additionalProperties": false
    },
    "CodeVisual": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "code"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "highlight": {
          "type": "array",
          "items": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "hotspots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "line": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "line"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "code",
        "language"
      ],
      "additionalProperties": false
    },
    "MathVisual": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "math"
        },
        "tex": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "tex"
      ],
      "additionalProperties": false
    },
    "ChartVisual": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "chart"
        },
        "type": {
          "type": "string",
          "enum": [
            "scatter",
            "bar",
            "line"
          ]
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "x": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            }
          },
          "additionalProperties": false
        },
        "y": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            }
          },
          "additionalProperties": false
        },
        "data": {
          "minItems": 2,
          "maxItems": 60,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  }
                ]
              },
              "y": {
                "type": "number"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              },
              "series": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          }
        },
        "trend": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "type",
        "data"
      ],
      "additionalProperties": false
    },
    "DiagramVisual": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "diagram"
        },
        "d2": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "kind",
        "d2"
      ],
      "additionalProperties": false
    },
    "Option": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "visual": {
          "$ref": "#/$defs/Visual"
        },
        "feedback": {
          "type": "string",
          "minLength": 1
        },
        "lang": {
          "type": "string",
          "minLength": 2,
          "maxLength": 35
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "CompareBrick": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "visual": {
          "$ref": "#/$defs/Visual"
        },
        "hint": {
          "type": "string",
          "minLength": 1
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "compare"
        },
        "options": {
          "minItems": 2,
          "maxItems": 2,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Option"
          }
        },
        "correct": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "prompt",
        "explanation",
        "type",
        "options",
        "correct"
      ],
      "additionalProperties": false
    },
    "Brick": {
      "oneOf": [
        {
          "$ref": "#/$defs/ConceptBrick"
        },
        {
          "$ref": "#/$defs/ChoiceBrick"
        },
        {
          "$ref": "#/$defs/CompareBrick"
        },
        {
          "$ref": "#/$defs/OrderBrick"
        },
        {
          "$ref": "#/$defs/SortBrick"
        },
        {
          "$ref": "#/$defs/MatchBrick"
        },
        {
          "$ref": "#/$defs/BlankBrick"
        },
        {
          "$ref": "#/$defs/HotspotBrick"
        },
        {
          "$ref": "#/$defs/ScenarioBrick"
        },
        {
          "$ref": "#/$defs/NumberBrick"
        }
      ]
    },
    "ConceptBrick": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "type": {
          "type": "string",
          "const": "concept"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "visual": {
          "$ref": "#/$defs/Visual"
        }
      },
      "required": [
        "id",
        "type",
        "title",
        "body"
      ],
      "additionalProperties": false
    },
    "OrderBrick": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "visual": {
          "$ref": "#/$defs/Visual"
        },
        "hint": {
          "type": "string",
          "minLength": 1
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "order"
        },
        "items": {
          "minItems": 3,
          "maxItems": 6,
          "type": "array",
          "items": {
            "$ref": "#/$defs/OrderItem"
          }
        },
        "alsoAccept": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        }
      },
      "required": [
        "id",
        "prompt",
        "explanation",
        "type",
        "items"
      ],
      "additionalProperties": false
    },
    "OrderItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "visual": {
          "$ref": "#/$defs/Visual"
        },
        "lang": {
          "type": "string",
          "minLength": 2,
          "maxLength": 35
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "SortBrick": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "visual": {
          "$ref": "#/$defs/Visual"
        },
        "hint": {
          "type": "string",
          "minLength": 1
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "sort"
        },
        "groups": {
          "minItems": 2,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "lang": {
                "type": "string",
                "minLength": 2,
                "maxLength": 35
              }
            },
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "items": {
          "minItems": 4,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "group": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "lang": {
                "type": "string",
                "minLength": 2,
                "maxLength": 35
              }
            },
            "required": [
              "id",
              "text",
              "group"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "prompt",
        "explanation",
        "type",
        "groups",
        "items"
      ],
      "additionalProperties": false
    },
    "MatchBrick": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "visual": {
          "$ref": "#/$defs/Visual"
        },
        "hint": {
          "type": "string",
          "minLength": 1
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "match"
        },
        "pairs": {
          "minItems": 3,
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "left": {
                "type": "string",
                "minLength": 1
              },
              "right": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "left",
              "right"
            ],
            "additionalProperties": false
          }
        },
        "leftLang": {
          "type": "string",
          "minLength": 2,
          "maxLength": 35
        },
        "rightLang": {
          "type": "string",
          "minLength": 2,
          "maxLength": 35
        }
      },
      "required": [
        "id",
        "prompt",
        "explanation",
        "type",
        "pairs"
      ],
      "additionalProperties": false
    },
    "BlankBrick": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "visual": {
          "$ref": "#/$defs/Visual"
        },
        "hint": {
          "type": "string",
          "minLength": 1
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "blank"
        },
        "template": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "enum": [
            "text",
            "code"
          ]
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "lang": {
          "type": "string",
          "minLength": 2,
          "maxLength": 35
        },
        "caseSensitive": {
          "type": "boolean"
        },
        "blanks": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Blank"
          }
        }
      },
      "required": [
        "id",
        "prompt",
        "explanation",
        "type",
        "template",
        "format",
        "blanks"
      ],
      "additionalProperties": false
    },
    "Blank": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "accept": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "choices": {
          "minItems": 2,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mistakes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "answer": {
                "type": "string",
                "minLength": 1
              },
              "feedback": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "answer",
              "feedback"
            ],
            "additionalProperties": false
          }
        },
        "numeric": {
          "type": "boolean"
        },
        "tolerance": {
          "type": "number",
          "minimum": 0
        },
        "strictAccents": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "accept"
      ],
      "additionalProperties": false
    },
    "HotspotBrick": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "visual": {
          "oneOf": [
            {
              "$ref": "#/$defs/HtmlVisual"
            },
            {
              "$ref": "#/$defs/CodeVisual"
            }
          ]
        },
        "hint": {
          "type": "string",
          "minLength": 1
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "hotspot"
        },
        "correct": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "multiple": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "prompt",
        "visual",
        "explanation",
        "type",
        "correct",
        "multiple"
      ],
      "additionalProperties": false
    },
    "ScenarioBrick": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "visual": {
          "$ref": "#/$defs/Visual"
        },
        "hint": {
          "type": "string",
          "minLength": 1
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "scenario"
        },
        "situation": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "minItems": 2,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "quality": {
                "type": "string",
                "enum": [
                  "best",
                  "okay",
                  "poor"
                ]
              },
              "outcome": {
                "type": "string",
                "minLength": 1
              },
              "lang": {
                "type": "string",
                "minLength": 2,
                "maxLength": 35
              }
            },
            "required": [
              "id",
              "text",
              "quality",
              "outcome"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "prompt",
        "explanation",
        "type",
        "situation",
        "options"
      ],
      "additionalProperties": false
    },
    "NumberBrick": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "visual": {
          "$ref": "#/$defs/Visual"
        },
        "hint": {
          "type": "string",
          "minLength": 1
        },
        "explanation": {
