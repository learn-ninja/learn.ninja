# Copy to apps/web/.env.local and fill in. Never commit real values.

# Lesson storage: a Postgres connection string. Adding Neon from the Vercel Marketplace sets it.
# The web app's build applies migrations to it (packages/db/drizzle). Without it, development keeps
# lessons in PGlite at apps/web/.data/pglite; set LEARN_PGLITE_DIR to use another folder, or to run
# a production build without a database (the browser tests do).
# DATABASE_URL=
# LEARN_PGLITE_DIR=

# Rate limits. Without these, development counts in memory.
# On Vercel, adding Upstash Redis from the Marketplace sets KV_REST_API_URL and KV_REST_API_TOKEN instead,
# which also work.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# The bearer token Vercel Cron sends to /api/cron/expire, which deletes expired lessons daily.
# Any long random string; without it the route refuses every request.
# CRON_SECRET=

# Optional: the public origin used in published links (defaults to the request's origin).
# LEARN_PUBLIC_URL=https://learn.ninja

# Accounts (Better Auth). Sessions are signed with this secret: any long random string, e.g.
# `openssl rand -base64 32`. Production needs it; a preview deployment without one derives a secret
# from its own database URL; development uses a default.
# BETTER_AUTH_SECRET=
# Optional: the site's origin for sign-in callbacks (defaults to the request's host, which is right
# for learn.ninja, preview deployments, and localhost alike).
# BETTER_AUTH_URL=https://learn.ninja

# Sign in with GitHub: an OAuth app under the learn-ninja org, with the callback URL
# https://learn.ninja/api/auth/callback/github. Without these, the sign-in page only offers email codes.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Sign-in codes by email, through Resend (https://resend.com) from mail.learn.ninja. Without the key,
# codes are printed to the server console instead.
# RESEND_API_KEY=
# EMAIL_FROM=learn.ninja <code@mail.learn.ninja>
