{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "spec": {
      "type": "string",
      "const": "0.9"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35
    },
    "targetLanguage": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35
    },
    "level": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "estimatedMinutes": {
      "type": "integer",
      "minimum": 3,
      "maximum": 15
    },
    "subject": {
      "type": "string",
      "enum": [
        "programming",
        "ai",
        "tools",
        "design",
        "business",
        "marketing",
        "money",
        "science",
        "math",
        "data",
        "health",
        "history",
        "society",
        "languages",
        "arts",
        "life",
        "careers"
      ]
    },
    "tags": {
      "minItems": 1,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 30,
        "pattern": "^[\\p{L}\\p{M}\\p{N}\\-+.&/'’](?:[\\p{L}\\p{M}\\p{N}\\-+#.&/'’ ]*[\\p{L}\\p{M}\\p{N}\\-+#.&/'’])?$"
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    },
    "hook": {
      "$ref": "#/$defs/HookKata"
    },
    "katas": {
      "minItems": 3,
      "maxItems": 20,
      "type": "array",
      "items": {
        "$ref": "#/$defs/Kata"
      }
    },
    "challenge": {
      "$ref": "#/$defs/QuestionKata"
    },
    "wrapup": {
      "type": "object",
      "properties": {
        "takeaways": {
          "minItems": 2,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "next": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "takeaways"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "spec",
    "title",
    "summary",
    "objective",
    "language",
    "level",
    "estimatedMinutes",
    "subject",
    "tags",
    "hook",
    "katas",
    "challenge",
    "wrapup"
  ],
  "additionalProperties": false,
  "$defs": {
    "HookKata": {
      "oneOf": [
        {
          "$ref": "#/$defs/ChoiceKata"
        },
        {
          "$ref": "#/$defs/CompareKata"
        }
      ]
    },
    "ChoiceKata": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "visual": {
          "$ref": "#/$defs/Visual"
        },
        "hint": {
          "type": "string",
          "minLength": 1
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "choice"
        },
        "options": {
          "minItems": 2,
          "maxItems": 5,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Option"
          }
        },
        "correct": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "multiple": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "prompt",
        "explanation",
        "type",
        "options",
        "correct",
        "multiple"
      ],
      "additionalProperties": false
    },
    "Visual": {
      "oneOf": [
        {
          "$ref": "#/$defs/HtmlVisual"
        },
        {
          "$ref": "#/$defs/CodeVisual"
        },
        {
          "$ref": "#/$defs/MathVisual"
        },
        {
          "$ref": "#/$defs/ChartVisual"
        },
        {
          "$ref": "#/$defs/DiagramVisual"
        },
        {
          "$ref": "#/$defs/NumberLineVisual"
        },
        {
          "$ref": "#/$defs/FractionVisual"
        },
        {
          "$ref": "#/$defs/ClockVisual"
        },
        {
          "$ref": "#/$defs/ChessVisual"
        },
        {
          "$ref": "#/$defs/MapVisual"
        },
        {
          "$ref": "#/$defs/MoleculeVisual"
        }
      ]
    },
    "HtmlVisual": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "html"
        },
        "html": {
          "type": "string",
          "minLength": 1
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "css": {
          "type": "string"
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "html"
      ],
      "additionalProperties": false
    },
    "CodeVisual": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "code"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "highlight": {
          "type": "array",
          "items": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "hotspots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "line": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "line"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "code",
        "language"
      ],
      "additionalProperties": false
    },
    "MathVisual": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "math"
        },
        "tex": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "tex"
      ],
      "additionalProperties": false
    },
    "ChartVisual": {
      "oneOf": [
        {
          "$ref": "#/$defs/DataChartVisual"
        },
        {
          "$ref": "#/$defs/FunctionChartVisual"
        }
      ]
    },
    "DataChartVisual": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "chart"
        },
        "type": {
          "type": "string",
          "enum": [
            "scatter",
            "bar",
            "line"
          ]
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "x": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            }
          },
          "additionalProperties": false
        },
        "y": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            }
          },
          "additionalProperties": false
        },
        "data": {
          "minItems": 2,
          "maxItems": 60,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  }
                ]
              },
              "y": {
                "type": "number"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              },
              "series": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          }
        },
        "trend": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "type",
        "data"
      ],
      "additionalProperties": false
    },
    "FunctionChartVisual": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "chart"
        },
        "type": {
          "type": "string",
          "const": "function"
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "x": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          },
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false
        },
        "y": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "series": {
          "minItems": 1,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "expression": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              }
            },
            "required": [
              "expression"
            ],
            "additionalProperties": false
          }
        },
        "points": {
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "type",
        "x"
      ],
      "additionalProperties": false
    },
    "DiagramVisual": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "diagram"
        },
        "d2": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "kind",
        "d2"
      ],
      "additionalProperties": false
    },
    "NumberLineVisual": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "numberline"
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fractions": {
          "type": "boolean"
        },
        "points": {
          "minItems": 1,
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12
              },
              "open": {
                "type": "boolean"
              }
            },
            "required": [
              "value"
            ],
            "additionalProperties": false
          }
        },
        "ranges": {
          "minItems": 1,
          "maxItems": 2,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "number"
              },
              "to": {
                "type": "number"
              },
              "fromOpen": {
                "type": "boolean"
              },
              "toOpen": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "jumps": {
          "minItems": 1,
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "number"
              },
              "to": {
                "type": "number"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12
              }
            },
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "min",
        "max"
      ],
      "additionalProperties": false
    },
    "FractionVisual": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "fraction"
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "shape": {
          "type": "string",
          "enum": [
            "bar",
            "circle"
          ]
        },
        "fractions": {
          "minItems": 1,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "parts": {
                "type": "integer",
                "minimum": 1,
                "maximum": 24
              },
              "shaded": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16
              }
            },
            "required": [
              "parts",
              "shaded"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "fractions"
      ],
      "additionalProperties": false
    },
    "ClockVisual": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "clock"
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "time": {
          "type": "string",
          "pattern": "^([01]?\\d|2[0-3]):[0-5]\\d$"
        },
        "numbers": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "time"
      ],
      "additionalProperties": false
    },
    "ChessVisual": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "chess"
        },
        "fen": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "highlight": {
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-h][1-8]$"
          }
        },
        "arrows": {
          "minItems": 1,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^[a-h][1-8]$"
              },
              "to": {
                "type": "string",
                "pattern": "^[a-h][1-8]$"
              }
            },
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false
          }
        },
        "flip": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "fen"
      ],
      "additionalProperties": false
    },
    "MapVisual": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "map"
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "region": {
          "type": "string",
          "enum": [
            "world",
            "africa",
            "europe",
            "asia",
            "middle-east",
            "central-asia",
            "south-asia",
            "east-asia",
            "southeast-asia",
            "north-america",
            "central-america",
            "south-america",
            "oceania",
            "mediterranean",
            "eastern-mediterranean"
          ]
        },
        "countries": {
          "minItems": 1,
          "maxItems": 60,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              },
              "group": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              }
            },
            "required": [
              "code"
            ],
            "additionalProperties": false
          }
        },
        "points": {
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lon": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              }
            },
            "required": [
              "lat",
              "lon"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "MoleculeVisual": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "molecule"
        },
        "smiles": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "style": {
          "type": "string",
          "enum": [
            "skeletal",
            "full"
          ]
        },
        "highlight": {
          "minItems": 1,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      },
      "required": [
        "kind",
        "smiles"
      ],
      "additionalProperties": false
    },
    "Option": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "visual": {
          "$ref": "#/$defs/Visual"
        },
        "feedback": {
          "type": "string",
          "minLength": 1
        },
        "lang": {
          "type": "string",
          "minLength": 2,
          "maxLength": 35
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "CompareKata": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "visual": {
          "$ref": "#/$defs/Visual"
        },
        "hint": {
          "type": "string",
          "minLength": 1
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "compare"
        },
        "options": {
          "minItems": 2,
          "maxItems": 2,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Option"
          }
        },
        "correct": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "prompt",
        "explanation",
        "type",
        "options",
        "correct"
      ],
      "additionalProperties": false
    },
    "Kata": {
      "oneOf": [
        {
          "$ref": "#/$defs/ConceptKata"
        },
        {
          "$ref": "#/$defs/ChoiceKata"
        },
        {
          "$ref": "#/$defs/CompareKata"
        },
        {
          "$ref": "#/$defs/OrderKata"
        },
        {
          "$ref": "#/$defs/SortKata"
        },
        {
          "$ref": "#/$defs/MatchKata"
        },
        {
          "$ref": "#/$defs/BlankKata"
        },
        {
          "$ref": "#/$defs/HotspotKata"
        },
        {
          "$ref": "#/$defs/ScenarioKata"
        },
        {
          "$ref": "#/$defs/NumberKata"
        }
      ]
    },
    "ConceptKata": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "type": {
          "type": "string",
          "const": "concept"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "visual": {
          "$ref": "#/$defs/Visual"
        }
      },
      "required": [
        "id",
        "type",
        "title",
        "body"
      ],
      "additionalProperties": false
    },
    "OrderKata": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "visual": {
