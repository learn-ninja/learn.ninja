{
  "extends": "@workspace/typescript-config/base.json",
  "compilerOptions": {
    // No DOM: everything here runs in the browser and in React Native alike.
    "lib": ["es2022"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
