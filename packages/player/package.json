{
  "name": "@workspace/player",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./prepare": "./src/prepare.ts",
    "./strings": "./src/strings.ts",
    "./plain-text": "./src/plain-text.ts",
    "./logo": "./src/logo.tsx",
    "./time": "./src/time.tsx",
    "./progress": "./src/progress.ts"
  },
  "scripts": {
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "stories:prepare": "tsx --conditions=react-server scripts/prepare-examples.ts",
    "pretypecheck": "npm run stories:prepare",
    "map": "tsx scripts/build-map.ts && tsx scripts/build-map-sizes.ts && prettier --write ../spec/src/countries.ts ../spec/src/map-sizes.ts"
  },
  "dependencies": {
    "@iconify-json/logos": "^1.2.17",
    "@iconify-json/lucide": "^1.2.147",
    "@iconify-json/octicon": "^1.2.39",
    "@iconify-json/simple-icons": "^1.2.100",
    "@iconify-json/vscode-icons": "^1.2.92",
    "@iconify/utils": "^3.1.7",
    "@observablehq/plot": "^0.6.17",
    "@terrastruct/d2": "^0.1.33",
    "@workspace/spec": "^0.0.0",
    "@workspace/ui": "^0.0.0",
    "d3-geo": "^3.1.1",
    "katex": "^0.19.0",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.52.0",
    "mathjs": "^15.2.0",
    "openchemlib": "^9.25.1",
    "react": "^19.3.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-simplify": "^3.0.3",
    "@types/topojson-specification": "^1.0.5",
    "@workspace/eslint-config": "^0.0.0",
    "@workspace/typescript-config": "^0.0.0",
    "eslint": "^10.12.0",
    "i18n-iso-countries": "^7.14.0",
    "topojson-simplify": "^3.0.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "world-atlas": "^2.0.2"
  }
}
