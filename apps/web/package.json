{
  "name": "web",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "visuals:css": "node scripts/build-visuals-css.mjs",
    "favicon": "node scripts/build-favicon.mjs",
    "smoke": "node scripts/build-smoke.mjs",
    "share": "tsx --tsconfig scripts/tsconfig.json scripts/build-share-images.tsx",
    "tags": "tsx --tsconfig scripts/tsconfig.json scripts/tag-report.ts",
    "tags:backfill": "tsx --tsconfig scripts/tsconfig.json scripts/backfill-tags.ts",
    "handles:backfill": "tsx --tsconfig scripts/tsconfig.json scripts/backfill-handles.ts",
    "predev": "npm run visuals:css",
    "prebuild": "npm run visuals:css && npm run migrate -w @workspace/db && tsx --tsconfig scripts/tsconfig.json scripts/backfill-on-deploy.ts",
    "test": "vitest run",
    "postinstall": "fumadocs-mdx",
    "e2e": "playwright test",
    "bento": "tsx --tsconfig ../../packages/player/tsconfig.json --import ./scripts/without-server-only.mjs scripts/build-bento.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.12",
    "@better-auth/cimd": "^1.7.12",
    "@better-auth/expo": "^1.7.12",
    "@better-auth/mcp": "^1.7.12",
    "@better-auth/oauth-provider": "^1.7.12",
    "@modelcontextprotocol/server": "^2.3.1",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@workspace/cli": "^0.0.0",
    "@workspace/db": "^0.0.0",
    "@workspace/player": "^0.0.0",
    "@workspace/player-core": "^0.0.0",
    "@workspace/spec": "^0.0.0",
    "@workspace/ui": "*",
    "better-auth": "^1.7.12",
    "drizzle-orm": "0.45.4",
    "fumadocs-core": "^16.10.5",
    "fumadocs-mdx": "^15.0.12",
    "jose": "^6.2.13",
    "katex": "^0.19.0",
    "lucide-react": "^1.52.0",
    "mathjax-full": "^3.2.2",
    "mcp-handler": "^2.3.0",
    "mdast-util-to-markdown": "^2.1.2",
    "next": "16.4.4",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@react-aria/optimize-locales-plugin": "^2.0.2",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@workspace/eslint-config": "*",
    "@workspace/typescript-config": "*",
    "basecoat-css": "^1.0.2",
    "eslint": "^10",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "unist-util-visit": "^5.1.0",
    "vitest": "^4.1.11"
  }
}
